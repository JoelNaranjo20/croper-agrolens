# Copy to services/<name>/.env for local development without Docker.

LOG_PRETTY=true          # human-readable logs in dev

# --- fields-service ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agrolens
AI_SERVICE_URL=http://localhost:8000

# --- api-gateway ---
FIELDS_SERVICE_URL=http://localhost:4001
AUTH_MODE=none            # jwt in production
DEV_TENANT_ID=demo
# AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# AUTH_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# AUTH_AUDIENCE=api://agrolens
# AUTH_TENANT_CLAIM=tenant_id
CORS_ORIGINS=http://localhost:4200
