{
  "name": "AgroLens",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "hostRequirements": { "memory": "8gb" },
  "forwardPorts": [8080, 4000, 8000],
  "portsAttributes": {
    "8080": { "label": "AgroLens (app)", "onAutoForward": "openBrowser" },
    "4000": { "label": "API Gateway (GraphiQL en /graphiql)", "onAutoForward": "silent" },
    "8000": { "label": "AI service (docs en /docs)", "onAutoForward": "silent" }
  },
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["angular.ng-template", "ms-python.python", "esbenp.prettier-vscode", "GraphQL.vscode-graphql"]
    }
  }
}
