    "@turf/boolean-valid": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "pino-pretty": "^13.2.0"
