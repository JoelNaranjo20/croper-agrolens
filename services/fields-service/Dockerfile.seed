# Dev-only image that runs the seed script with tsx (not shipped to production).
FROM node:22.12-alpine
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY services/fields-service/package.json services/fields-service/
RUN npm ci -w services/fields-service --include-workspace-root
COPY services/fields-service services/fields-service
CMD ["npm", "run", "seed", "-w", "services/fields-service"]
