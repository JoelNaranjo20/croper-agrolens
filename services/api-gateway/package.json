    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "graphql": "^16.11.0",
    "jose": "^6.2.15",
    "mercurius": "^16.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
