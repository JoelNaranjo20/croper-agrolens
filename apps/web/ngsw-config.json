{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "graphql-queries",
      "urls": ["/graphql?**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxSize": 200,
        "maxAge": "7d"
      }
    },
    {
      "name": "observation-images",
      "urls": ["/api/v1/observations/*/image"],
      "cacheConfig": { "strategy": "performance", "maxSize": 300, "maxAge": "30d" }
    },
    {
      "name": "map-tiles",
      "urls": ["https://tile.openstreetmap.org/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 600, "maxAge": "14d" }
    }
  ]
}
