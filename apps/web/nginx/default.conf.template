# Rendered at container start by the nginx image's envsubst entrypoint (only ${GATEWAY_URL};
# nginx's own $variables are untouched because only defined env vars are substituted).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  gzip on;
  gzip_comp_level 6;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  # add_header is not inherited once a location defines its own, so headers live in a snippet.
  include /etc/nginx/snippets/security-headers.conf;

  location = /healthz { access_log off; return 200 'ok'; }

  # Same-origin API: no CORS preflights, one TLS handshake on slow rural networks.
  location /graphql {
    proxy_pass ${GATEWAY_URL};
    include /etc/nginx/snippets/proxy.conf;
  }
  location /api/ {
    client_max_body_size 6m;
    proxy_pass ${GATEWAY_URL};
    include /etc/nginx/snippets/proxy.conf;
  }

  # Hashed bundles: cache forever.
  location ~* \.(?:js|css|woff2?|png|svg|ico)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Entry points must always revalidate, or users get stuck on old versions.
  location ~* ^/(index\.html|ngsw\.json|ngsw-worker\.js|safety-worker\.js|manifest\.webmanifest)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
